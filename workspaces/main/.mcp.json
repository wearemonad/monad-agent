{
  "mcpServers": {
    "twenty": {
      "type": "http",
      "url": "${TWENTY_BASE_URL}/mcp?mode=direct",
      "headers": {
        "Authorization": "Bearer ${TWENTY_API_KEY}"
      }
    },
    "posthog": {
      "type": "http",
      "url": "https://mcp.posthog.com/mcp",
      "headers": {
        "Authorization": "Bearer ${POSTHOG_PERSONAL_API_KEY}"
      }
    }
  }
}
