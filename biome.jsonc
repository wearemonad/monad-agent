{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/node_modules/",
      "!app/dist/",
      "!app/build/",
      "!app/artifacts/",
      "!workspaces/",
      "!**/bun.lock",
      // Biome has no HTML formatter; the plans in here are hand-written docs.
      "!**/*.html"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  // Tailwind v4 puts @theme / @plugin / @custom-variant in the stylesheet;
  // without this the parser rejects index.css outright.
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        // Every `any` in this codebase sits on an untyped third-party boundary
        // — googleapis REST payloads, the Claude Agent SDK's message union,
        // Electrobun's FFI/RPC. tsconfig has strict:true and `tsc --noEmit` is
        // the real type gate; re-typing those boundaries by hand would trade
        // real risk for no checking we don't already have.
        "noExplicitAny": "off",
        // Deliberate literals: MCP server configs and the connector catalog
        // ship "${VAR}" placeholders that are expanded at runtime, not by JS.
        "noTemplateCurlyInString": "off"
      },
      "style": {
        // Concentrated in tests (`find(...)!` right after asserting presence)
        // and at the same untyped boundaries as noExplicitAny above.
        "noNonNullAssertion": "off"
      }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "off" } } },
  "overrides": [
    {
      // The RPC contract types `params: {}` to mean "this call takes none".
      // Record<string, never> would read the same but has to satisfy
      // Electrobun's own generic constraints — not worth the churn.
      "includes": ["app/src/shared/ipc.ts"],
      "linter": { "rules": { "complexity": { "noBannedTypes": "off" } } }
    },
    {
      // Stripping C0/C7F control characters out of Drive filenames and Gmail
      // headers is the whole point of these regexes.
      "includes": [
        "app/src/bun/services/GoogleDriveService.ts",
        "app/src/bun/services/googleTools.test.ts"
      ],
      "linter": {
        "rules": { "suspicious": { "noControlCharactersInRegex": "off" } }
      }
    },
    {
      // Generated by `shadcn add` and overwritten by it — upstream's markup,
      // not ours to diverge from. Still formatted, just not linted.
      "includes": ["app/src/mainview/components/ui/**"],
      "linter": { "enabled": false }
    }
  ]
}
