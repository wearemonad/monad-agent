{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "ES2021.Promise", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/mainview/*"],
      // Electrobun 2's npm package is only a launcher; the SDK lives in the
      // devkit Hutch projects into .hutch/devkit (run `bunx electrobun sync`).
      // Mapped here rather than extending .hutch/devkit/tsconfig.json, whose
      // baseUrl TypeScript 7 rejects (TS5102). Bun honors these at runtime
      // too, so bun test resolves the same files.
      "electrobun": ["./.hutch/devkit/api/sdks/main/index.ts"],
      "electrobun/main": ["./.hutch/devkit/api/sdks/main/index.ts"],
      "electrobun/view": ["./.hutch/devkit/api/browser/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "build", "../../package/dist"]
}
