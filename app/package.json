{
  "name": "monad",
  "version": "0.6.5",
  "description": "Monad — chat UI over the company brain (Claude Agent SDK + Electrobun)",
  "scripts": {
    "start": "vite build && electrobun dev",
    "dev": "concurrently -k \"bun run hmr\" \"vite build && electrobun dev --watch\"",
    "dev:hmr": "bun run dev",
    "hmr": "vite --port 5173",
    "icons": "bun scripts/generate-iconset.ts",
    "build:canary": "bun run icons && vite build && electrobun build --env=canary",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "postinstall": "electrobun sync"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "@base-ui/react": "^1.9.0",
    "@flowershow/remark-wiki-link": "3.4.0",
    "@googleapis/calendar": "^20.1.0",
    "@googleapis/drive": "^26.0.1",
    "@googleapis/gmail": "^22.0.2",
    "@hookform/resolvers": "^5.9.1",
    "@huggingface/transformers": "^4.3.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@openai/codex-sdk": "^0.167.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.1",
    "effect": "4.1.2",
    "google-auth-library": "11.3.3",
    "graphology": "^0.26.0",
    "graphology-types": "^0.24.8",
    "lucide-react": "^1.70.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^12.3.0",
    "onnxruntime-common": "1.31.1",
    "onnxruntime-node": "1.31.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-force-graph-2d": "^1.29.2",
    "react-hook-form": "^7.91.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.19.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^3.7.0",
    "thinking-orbs": "^0.3.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/d3-force": "^3.0.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "electrobun": "2.0.6",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  }
}
