# Build credentials for signed/notarized releases — copy to .env (bun auto-loads it).
# Leave unset to build unsigned local canaries. Never commit .env.

# Code-signing identity, e.g. "Developer ID Application: Your Company Ltd (TEAMID1234)"
ELECTROBUN_DEVELOPER_ID=

# Notarization (Apple ID flavor)
ELECTROBUN_APPLEID=you@example.com
ELECTROBUN_APPLEIDPASS=app-specific-password
ELECTROBUN_TEAMID=TEAMID1234

# Auto-updates: public base URL of the R2 bucket serving the artifacts folder
# (e.g. https://pub-xxxxxxxx.r2.dev or https://updates.yourdomain.com).
# Baked into builds; apps poll <url>/<channel>-macos-arm64-update.json.
MONAD_UPDATE_BASE_URL=

# Built-in Google OAuth client ("Desktop app" type) baked into official builds so
# users can connect Google without creating their own. Leave unset for source
# builds — users then add their own client in Settings → Google. release.sh
# refuses to publish without these. See docs/google-oauth.md.
MONAD_GOOGLE_CLIENT_ID=
MONAD_GOOGLE_CLIENT_SECRET=
